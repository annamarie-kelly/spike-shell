{
  "name": "spike",
  "version": "0.5.1",
  "description": "A native-feeling shell around Claude Code: file tree, multiple named terminals with Chrome-style groups, and open-any-folder.",
  "type": "commonjs",
  "scripts": {
    "build": "node build.mjs",
    "build:web": "SPIKE_EDITION=shell node build-web.mjs",
    "build:cli": "mkdir -p bin && cargo build --release --manifest-path src-tauri/Cargo.toml --bin spike-cli && cp -f src-tauri/target/release/spike-cli bin/spike",
    "dev": "node build.mjs --watch",
    "tauri": "tauri",
    "dev:tauri": "tauri dev",
    "build:tauri": "tauri build",
    "install:app": "tauri build --bundles app && rm -rf /Applications/Spike.app && ditto src-tauri/target/release/bundle/macos/Spike.app /Applications/Spike.app && echo 'Spike.app updated in /Applications — relaunch it to pick up the new build'",
    "typecheck": "tsc --noEmit",
    "test": "node build.mjs && node --test",
    "check:boundary": "node scripts/check-tauri-boundary.mjs",
    "verify": "node scripts/check-tauri-boundary.mjs && npm test",
    "verify:web": "node verify/run.mjs",
    "prepare": "node build.mjs"
  },
  "keywords": [
    "claude-code",
    "terminal",
    "pty",
    "xterm",
    "shell"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@highlightjs/cdn-assets": "^11.11.1",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "dompurify": "^3.4.11",
    "marked": "^12.0.2",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.2",
    "@types/node": "^22.10.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.0"
  }
}
